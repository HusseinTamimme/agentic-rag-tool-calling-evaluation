    "import os\n",
    "from google import genai\n",
    "from google.genai import types\n",
    "from pydantic import BaseModel, Field"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 65,
   "id": "b060fd1f-d274-4ab0-9811-31e9742d08e6",
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "client = genai.Client(api_key=\"I removed The API key")\n",
    "def run_agent_pipeline(user_query: str) -> AssistantResponse:\n",
    "    # A. Retrieve relevant context from ChromaDB\n",
    "    query_results = collection.query(query_texts=[user_query], n_results=2)\n",
    "    retrieved_context = \"\\n---\\n\".join(query_results[\"documents\"][0])\n",
    "    \n",
    "    # B. Construct Prompt with context\n",
    "    full_prompt = f\"\"\"You are a precise technical AI assistant.\n",
    "Use the following retrieved context to answer the user's question.\n",
    "\n",
    "CRITICAL INSTRUCTIONS:\n",
    "1. Always populate the 'citations' field with the exact source name and verbatim quote from the context used to find the answer.\n",
    "2. If you perform calculations, use the calculate_expression tool.\n",
    "\n",
    "Retrieved Context:\n",
    "{retrieved_context}\n",
    "\n",
    "User Question: {user_query}\n",
    "\"\"\"\n",
    "\n",
    "    # C. Call Gemini with Tool Calling + Pydantic Structured Output\n",
    "    response = client.models.generate_content(\n",
    "        model=\"gemini-3.6-flash\",\n",
    "        contents=full_prompt,\n",
    "        config=types.GenerateContentConfig(\n",
    "            tools=[calculate_expression],\n",
    "            response_mime_type=\"application/json\",\n",
    "            response_schema=AssistantResponse\n",
    "        )\n",
    "    )\n",
    "\n",
    "    # D. Parse validated Pydantic object directly\n",
    "    return AssistantResponse.model_validate_json(response.text)"
   ]
  },
