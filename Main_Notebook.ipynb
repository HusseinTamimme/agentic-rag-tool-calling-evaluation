   "source": [
    "import chromadb\n",
    "from chromadb.utils import embedding_functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "7bdb6da5-1a3f-438e-9128-5b9845aa9a3c",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Intialize in-memory chromadb client\n",
    "client=chromadb.Client()\n",
    "embdun=embedding_functions.DefaultEmbeddingFunction()\n",
    "collection=client.get_or_create_collection(\n",
    "    name=\"knowledge_base\",\n",
    "    embedding_function=embdun)\n",
    "doc_ids=[f\"doc_chunks_{i}\" for i in range(len(chunks))]\n",
    "meta=[{\"source\": \"apollo_overview.txt\",\"chunk_index\":i} for i in range(len(chunks))]\n",
    "\n",
    "collection.add(documents=chunks,metadatas=meta,ids=doc_ids)"
   ]
