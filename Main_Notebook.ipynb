   "source": [
    "import tiktoken as tktk"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "1ae00566-9986-449a-ba65-674f7133ea1f",
   "metadata": {},
   "outputs": [],
   "source": [
    "def chunk_text(text: str, chunksize: int = 300, overlap: int = 50) -> list[str]:\n",
    "    \"\"\"\n",
    "    Splits raw text into token-bounded chunks with a sliding window overlap.\n",
    "    \"\"\"\n",
    "    tokenizer=tktk.get_encoding(\"cl100k_base\")\n",
    "    tokens = tokenizer.encode(text)\n",
    "    chunks=[]\n",
    "    start =0\n",
    "    while start < len(tokens):\n",
    "        end= start + chunksize\n",
    "        chunk_tokens=tokens[start:end]\n",
    "        chunks.append(tokenizer.decode(chunk_tokens))\n",
    "        #move forward by (chunk size-overlap)\n",
    "        start = start+chunksize-overlap\n",
    "        if (start>=len(tokens)) and (len(chunks)==0):\n",
    "            chunks.append(tokenizer.decode(chunk_tokens))\n",
    "            break\n",
    "    return chunks"
   ]
  },
