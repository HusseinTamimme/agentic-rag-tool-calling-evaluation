   "source": [
    "from typing import Literal\n",
    "from pydantic import BaseModel, Field\n",
    "from google.genai import types"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 71,
   "id": "ea6662e0-e3c6-48d4-b2bc-a2ef44731e3a",
   "metadata": {},
   "outputs": [],
   "source": [
    "class EvaluationResult(BaseModel):\n",
    "    faithfulness_verdict: Literal[\"PASS\",\"FAIL\"] = Field(\n",
    "        description=\"'PASS' if all factual claims are supported by the context, 'FAIL' if any claim is ungrounded or hallucinated.\"\n",
    "    )\n",
    "    faithfulness_score: float = Field(\n",
    "        description=\"Score between 0.0 and 1.0 indicating degree of factual support (1.0 = fully grounded).\"\n",
    "    )\n",
    "    citation_accuracy: Literal[\"PASS\", \"FAIL\"] = Field(\n",
    "        description=\"'PASS' if all cited quotes are accurate and present in the source, 'FAIL' otherwise.\"\n",
    "    )\n",
    "    unsupported_claims: list[str] = Field(\n",
    "        default_factory=list,\n",
    "        description=\"Specific sentences or assertions from the answer not supported by the context.\"\n",
    "    )\n",
    "    reasoning: str = Field(\n",
    "        description=\"Step-by-step audit explaining why the verdict was assigned.\"\n",
    "    )"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 72,
   "id": "6c8d3ada-3cf8-444e-bdea-19eeecd443c8",
   "metadata": {},
   "outputs": [],
   "source": [
    "def evaluate_rag_response(\n",
    "    question: str, \n",
    "    context: str, \n",
    "    response: AssistantResponse\n",
    ") -> EvaluationResult:\n",
    "    \"\"\"\n",
    "    Evaluates an AssistantResponse for hallucination, faithfulness, and citation validity.\n",
    "    \"\"\"\n",
    "    citations_text = \"\\n\".join([f\"- [{c.source}]: \\\"{c.quote}\\\"\" for c in response.citations])\n",
    "    \n",
    "    eval_prompt = f\"\"\"You are an unbiased AI System Quality Evaluator.\n",
    "Audit the following AI-generated answer against the provided ground-truth context.\n",
    "\n",
    "Ground-Truth Context:\n",
    "{context}\n",
    "\n",
    "User Question:\n",
    "{question}\n",
    "\n",
    "Generated Answer to Audit:\n",
    "{response.answer}\n",
    "\n",
    "Extracted Citations:\n",
    "{citations_text if citations_text else 'None provided'}\n",
    "\n",
    "EVALUATION RULES:\n",
    "1. Mathematical calculations derived from valid context numbers are considered faithful.\n",
    "2. If the answer contains any claim or named entity not found in the context (or derived via math), flag it as unsupported and mark faithfulness as 'FAIL'.\n",
    "3. Verify that every citation quote exists in the ground-truth context.\n",
    "\"\"\"\n",
    "\n",
    "    eval_response = client.models.generate_content(\n",
    "        model=\"gemini-3.6-flash\",\n",
    "        contents=eval_prompt,\n",
    "        config=types.GenerateContentConfig(\n",
    "            temperature=0.0,  # Zero temperature for deterministic grading\n",
    "            response_mime_type=\"application/json\",\n",
    "            response_schema=EvaluationResult\n",
    "        )\n",
    "    )\n",
    "\n",
    "    return EvaluationResult.model_validate_json(eval_response.text)"
   ]
  },
