   "source": [
    "def calculate_expression(expression: str) ->str:\n",
    "    \"\"\"safely evaluates basic arthimetic expressions\"\"\"\n",
    "    try:\n",
    "        #Restricted evaluation for safe mathematical computing\n",
    "        allowed_names={\"__builtins__\": None}\n",
    "        result = eval(expression,allowed_names,{})\n",
    "        return json.dumps({\"result\":result})\n",
    "    except Exception as e:\n",
    "        return json.dumps({\"error\": str(e)})"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "7744229a-ad9b-40e3-979c-2e003bdfd05b",
   "metadata": {},
   "outputs": [],
   "source": [
    "#for OpenAI Tool (Definition)\n",
    "tools = [\n",
    "    {\n",
    "        \"type\": \"function\",  # This must be present at the top level\n",
    "        \"function\": {\n",
    "            \"name\": \"calculate_expression\",\n",
    "            \"description\": \"Perform exact mathematical evaluations for arithmetic calculations.\",\n",
    "            \"parameters\": {\n",
    "                \"type\": \"object\",\n",
    "                \"properties\": {\n",
    "                    \"expression\": {\n",
    "                        \"type\": \"string\",\n",
    "                        \"description\": \"The math expression to evaluate, e.g., '2026 - 1969'\"\n",
    "                    }\n",
    "                },\n",
    "                \"required\": [\"expression\"]\n",
    "            }\n",
    "        }\n",
    "    }\n",
    "]"
   ]
  },
